#include <iostream>
using namespace std;

int main()
{
    int n, a = 0, b = 1, c, step = 0;
    cout << "Enter the number of terms :";
    cin >> n;

    for (int i = 0; i < n; i++)
    {
        cout << a << " ";
        c = a + b;
        a = b;
        b = c;
        step++;
    }
    return 0;
}
