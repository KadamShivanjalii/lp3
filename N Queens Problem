
#include <iostream>
using namespace std;

int a[8][8] = {};

bool safe(int r, int c) {
    for(int i = 0; i < r; i++)
        if(a[i][c]) return false;

    for(int i = r-1, j = c-1; i >= 0 && j >= 0; i--, j--)
        if(a[i][j]) return false;

    for(int i = r-1, j = c+1; i >= 0 && j < 8; i--, j++)
        if(a[i][j]) return false;

    return true;
}

bool solve(int r) {
    if(r == 8) return true;

    for(int c = 0; c < 8; c++)
        if(safe(r, c)) {
            a[r][c] = 1;

            if(solve(r+1)) return true;

            a[r][c] = 0;
        }

    return false;
}

int main() {
    a[0][0] = 1;

    if(solve(1)) {
        for(int i = 0; i < 8; i++) {
            for(int j = 0; j < 8; j++)
                cout << a[i][j] << " ";
            cout << endl;
        }
    }
    else cout << "No solution";

    return 0;
}
